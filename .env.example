# ── Libaas Couture Studio — environment configuration ──────────────
# Copy this file to `.env.local` for local development.
# `.env.local` is git-ignored; never commit real secrets.

# Secret used to sign admin session cookies (any long random string).
# Required for admin login to work.
SESSION_SECRET=

# TEMPORARY dev-only admin password gate (Phase 1 foundation).
# Will be replaced by real admin accounts + roles in a later phase.
# If unset, admin login is disabled entirely.
ADMIN_DEV_PASSWORD=

# Data provider backing the repository layer.
# "file"     = JSON file at <DATA_DIR>/dev-store.json (default; survives restarts)
# "memory"   = in-memory, wiped on every restart
# "postgres" = PostgreSQL via Prisma — requires DATABASE_URL (Phase 5D)
DATA_PROVIDER=file

# PostgreSQL connection string — required ONLY when DATA_PROVIDER=postgres.
# NEVER commit a real value anywhere (this file stays a placeholder).
# For Neon, use the POOLED connection string. Apply the schema with
# `npx prisma migrate deploy`, then import the JSON store with
# `node scripts/migrate-to-postgres.mjs` (see docs/phase-5d-database.md).
DATABASE_URL=

# Base directory for local data — the JSON store AND uploaded media.
# Defaults to `.data`. Relative paths resolve against the working directory.
# Point this at a scratch directory to run a server against an isolated
# store (the corruption tests do exactly that, so they can never reach real
# customer data). Leave it unset for normal development.
#
# Whatever this points at holds password hashes and customer details. The
# server drops a self-ignoring .gitignore into the directory on startup, and
# the store file is ignored by name at any depth, so pointing it inside the
# repository still cannot leak data into git.
DATA_DIR=

# Public base URL of the site (used for metadata / links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Instagram feed (Phase 6B) — OPTIONAL ───────────────────────────
# When unset, the site simply shows no Instagram section; nothing breaks.
# Long-lived access token from a Meta app with "Instagram API with
# Instagram Login", for the studio's professional account. Server-side
# only; never sent to browsers, never commit a real value.
# Setup + 60-day refresh: docs/phase-6b-instagram.md
# Refresh with: node scripts/refresh-instagram-token.mjs
INSTAGRAM_ACCESS_TOKEN=

# Instagram user id for the feed. Leave unset for "me" (the token owner).
INSTAGRAM_USER_ID=

# Graph API base URL override — for automated tests ONLY. Leave unset.
INSTAGRAM_GRAPH_API_BASE_URL=

# ── Email delivery — READ BEFORE PRODUCTION (Phase 12 audit finding) ──
# The only EmailProvider implemented today (src/server/email/index.ts)
# prints password-reset links to the server console. That is correct and
# necessary for local development (no external service needed to test the
# reset flow) but is NOT safe for a real deployment: anyone with log/console
# access could read a customer's password-reset link and take over their
# account. There is no environment variable that changes this — before
# taking this app to production you MUST implement a real EmailProvider
# (Resend/SES/Postmark/etc.) behind the existing EmailProvider interface in
# src/server/email/index.ts and wire it into getEmailProvider(). This is
# documented rather than enforced at boot: NODE_ENV is set to "production"
# by `next build` itself, before any deployment-specific configuration
# exists, so a build-time or import-time check here would break every
# production build rather than catch a real misconfiguration.
