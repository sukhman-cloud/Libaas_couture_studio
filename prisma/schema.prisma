// Libaas Couture Studio — PostgreSQL schema (Phase 5D).
//
// This schema is a RELATIONAL TRANSLATION of the existing domain model in
// src/types/domain.ts — it invents nothing. Arrays that were embedded in
// JSON documents (addresses, measurement values, product media, cart and
// wishlist items, collection/secondary-category membership) become child
// tables with a `position` column so the original array order round-trips
// exactly. Everything else maps one-to-one.
//
// CONVENTIONS
// - IDs are TEXT and supplied by the application (crypto.randomUUID), never
//   generated by the database: the JSON→PostgreSQL migration preserves every
//   existing id byte-for-byte, and a missing id should fail loudly rather
//   than be silently minted.
// - Timestamps are application-managed. There is deliberately NO @updatedAt
//   and NO @default(now()): the domain sets these itself, and the migration
//   must carry original values through unchanged.
// - Money is integer paise in BIGINT plus a currency column. Never floats.
// - ON DELETE is RESTRICT everywhere (no hard-delete paths exist in the
//   application — catalog and customer records are archived, not deleted),
//   with one deliberate exception documented inline.
// - Uniqueness the application depends on (email, SKU, slugs, one cart and
//   wishlist per user, one product per wishlist) is enforced HERE, not only
//   in application code.
//
// The full decision log lives in docs/phase-5d-database.md.

generator client {
  provider        = "prisma-client-js"
  // relationJoins: lets reads that include child rows run as ONE SQL
  // statement (relationLoadStrategy "join"), so a lock-free reader sees a
  // consistent MVCC snapshot of parent + children — the same atomicity the
  // in-memory store gave readers for free.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (closed vocabularies from src/types/domain.ts) ────────────

enum UserKind {
  customer
  admin

  @@map("user_kind")
}

enum CatalogStatus {
  draft
  published
  archived

  @@map("catalog_status")
}

enum ProductAvailability {
  available
  made_to_order
  out_of_stock
  discontinued

  @@map("product_availability")
}

enum AddressLabel {
  home
  work
  other

  @@map("address_label")
}

enum MeasurementUnit {
  cm
  in

  @@map("measurement_unit")
}

enum FitPreference {
  fitted
  regular
  relaxed

  @@map("fit_preference")
}

/// Phase 6C: deliberately one value — every order is created `pending`
/// (placed, awaiting the studio; NO payment has occurred). Future phases
/// extend this enum additively via their own migrations.
enum OrderStatus {
  pending
  confirmed
  processing
  ready
  completed
  cancelled

  @@map("order_status")
}

// ── Identity ────────────────────────────────────────────────────────

model User {
  id        String   @id
  kind      UserKind
  name      String
  email     String?  @unique
  phone     String?
  isActive  Boolean  @map("is_active")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  credential            AuthCredential?
  profile               CustomerProfile?
  passwordResetTokens   PasswordResetToken[]
  measurementProfiles   MeasurementProfile[]
  cart                  Cart?
  wishlist              Wishlist?
  orders                Order[]
  customizationRequests CustomizationRequest[]
  orderActivities       OrderActivity[]        @relation("OrderActivityActor")
  orderNotes            OrderNote[]            @relation("OrderNoteAuthor")
  customizationActivities CustomizationActivity[] @relation("CustomizationActivityActor")
  customizationNotes      CustomizationNote[]      @relation("CustomizationNoteAuthor")

  @@map("users")
}

model AuthCredential {
  id     String @id
  userId String @unique @map("user_id")

  /// scrypt hash string (scrypt$N$r$p$salt$hash) — never plaintext.
  passwordHash String @map("password_hash")

  /// Monotonic — only ever counts up. The repository layer rejects a write
  /// that would lower it (see CredentialRepository.update); sessions embed
  /// the version they were minted with.
  sessionVersion Int      @map("session_version")
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("auth_credentials")
}

model PasswordResetToken {
  id     String @id
  userId String @map("user_id")

  /// SHA-256 of the raw token; the raw value is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Customer ────────────────────────────────────────────────────────

model CustomerProfile {
  id     String @id
  userId String @unique @map("user_id")

  /// SET NULL exception to the Restrict policy: the provider rewrites the
  /// address list as delete-and-recreate inside one transaction; SET NULL
  /// keeps the intermediate state valid without deferring constraints. The
  /// application re-points the default in the same write.
  defaultAddressId String?  @map("default_address_id")
  acceptsMarketing Boolean  @map("accepts_marketing")
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  defaultAddress CustomerAddress?  @relation("ProfileDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  addresses      CustomerAddress[] @relation("ProfileAddresses")

  @@map("customer_profiles")
}

model CustomerAddress {
  id        String @id
  profileId String @map("profile_id")

  /// Original position in the profile's address array — preserves order.
  position   Int
  label      AddressLabel
  fullName   String       @map("full_name")
  phone      String
  line1      String
  line2      String?
  locality   String?
  city       String
  state      String
  postalCode String       @map("postal_code")
  country    String

  profile   CustomerProfile   @relation("ProfileAddresses", fields: [profileId], references: [id], onDelete: Restrict)
  defaultOf CustomerProfile[] @relation("ProfileDefaultAddress")

  @@index([profileId])
  @@map("customer_addresses")
}

model MeasurementProfile {
  id String @id

  /// Owning USER id — the ownership anchor is User, never CustomerProfile.
  /// (Store v4 renamed this from `customerId`, which held a User id.)
  userId String @map("user_id")

  label         String
  unit          MeasurementUnit
  fitPreference FitPreference?  @map("fit_preference")
  notes         String?
  isDefault     Boolean         @map("is_default")

  /// Soft delete — archived profiles are hidden but preserved.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  values                MeasurementValue[]
  customizationRequests CustomizationRequest[]

  @@index([userId])
  @@map("measurement_profiles")
}

model MeasurementValue {
  profileId String @map("profile_id")

  /// Measurement key from the catalog (src/config/measurements.ts); unknown
  /// keys are allowed by design, so this is TEXT, not an enum.
  key      String
  value    Float
  position Int

  profile MeasurementProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@id([profileId, key])
  @@map("measurement_values")
}

/// Phase 7B: only `draft` is produced today; the remaining states are the
/// documented roadmap for the future quoting workflow.
enum CustomizationStatus {
  pending
  reviewing
  draft
  quoted
  approved
  in_progress
  completed
  rejected
  cancelled

  @@map("customization_status")
}

/// Customization-request foundation (Phase 7B). Deliberately minimal —
/// reference-image uploads and cart/order attachment arrive with the
/// designer phase. All FKs RESTRICT: a request never blocks softly-deleted
/// rows (nothing hard-deletes users/products/profiles anyway) and history
/// is never cascaded away.
model CustomizationRequest {
  id     String @id
  userId String @map("user_id")

  /// Absent for fully custom designs.
  productId            String? @map("product_id")
  measurementProfileId String? @map("measurement_profile_id")
  orderId              String? @map("order_id")
  orderItemId          String? @map("order_item_id")

  /// Customer free text — untrusted, app-capped, always rendered escaped.
  details String

  status    CustomizationStatus
  createdAt DateTime            @map("created_at")
  updatedAt DateTime            @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  measurementProfile MeasurementProfile? @relation(fields: [measurementProfileId], references: [id], onDelete: Restrict)
  order             Order?             @relation("CustomizationOrder", fields: [orderId], references: [id], onDelete: Restrict)
  orderItem         OrderItem?         @relation("CustomizationOrderItem", fields: [orderItemId], references: [id], onDelete: Restrict)
  activities        CustomizationActivity[]
  notes             CustomizationNote[]

  @@index([userId])
  @@index([orderId])
  @@index([orderItemId])
  @@map("customization_requests")
}

// ── Catalog ─────────────────────────────────────────────────────────

model MediaAsset {
  id String @id

  /// Opaque storage-provider key (uuid.ext) — local disk today, object
  /// storage later. Never a filesystem path.
  storageKey   String   @unique @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  createdAt    DateTime @map("created_at")

  productMedia    ProductMedia[]
  categoryMedia   Category[]
  collectionCover Collection[]

  @@map("media_assets")
}

model Category {
  id          String  @id
  slug        String  @unique
  name        String
  description String?
  parentId    String? @map("parent_id")
  mediaId     String? @map("media_id")
  sortOrder   Int     @map("sort_order")

  status     CatalogStatus
  archivedAt DateTime?     @map("archived_at")
  createdAt  DateTime      @map("created_at")
  updatedAt  DateTime      @map("updated_at")

  /// Hierarchy cycles are prevented at the application level (the admin
  /// action walks the ancestor chain); the FK only guarantees existence.
  parent   Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]  @relation("CategoryHierarchy")
  media    MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  primaryProducts Product[]
  secondaryLinks  ProductSecondaryCategory[]

  @@index([status])
  @@map("categories")
}

model Collection {
  id           String  @id
  slug         String  @unique
  name         String
  description  String?
  coverMediaId String? @map("cover_media_id")
  sortOrder    Int     @map("sort_order")

  status     CatalogStatus
  archivedAt DateTime?     @map("archived_at")
  createdAt  DateTime      @map("created_at")
  updatedAt  DateTime      @map("updated_at")

  coverMedia MediaAsset?         @relation(fields: [coverMediaId], references: [id], onDelete: Restrict)
  products   ProductCollection[]

  @@index([status])
  @@map("collections")
}

model Product {
  id   String @id
  /// Unique, stored uppercase (normalized by validation at the boundary).
  sku  String @unique
  /// Unique, URL-safe, lowercase (slugify at the boundary).
  slug String @unique

  name             String
  shortDescription String? @map("short_description")
  description      String

  categoryId String? @map("category_id")

  // Money: integer paise, never floats. BIGINT per the migration plan.
  priceAmount       BigInt  @map("price_amount")
  priceCurrency     String  @map("price_currency")
  salePriceAmount   BigInt? @map("sale_price_amount")
  salePriceCurrency String? @map("sale_price_currency")

  status       CatalogStatus
  availability ProductAvailability
  isFeatured   Boolean             @map("is_featured")

  // ProductAttributes: the five keys the catalog filters/facets on are real
  // columns; the open-ended `extra` map stays JSONB. See the decision log.
  fabric          String?
  colour          String?
  occasion        String?
  work            String?
  fit             String?
  attributesExtra Json?   @map("attributes_extra")

  /// Free-form labels; filtered with `includes` — a TEXT[] keeps order and
  /// round-trips exactly. See the decision log for array vs join table.
  tags String[]

  stitchingAvailable     Boolean @map("stitching_available")
  customizationAvailable Boolean @map("customization_available")

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")

  category              Category?                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  secondaryCategories   ProductSecondaryCategory[]
  collections           ProductCollection[]
  media                 ProductMedia[]
  cartItems             CartItem[]
  wishlistItems         WishlistItem[]
  orderItems            OrderItem[]
  customizationRequests CustomizationRequest[]

  @@index([status])
  @@index([availability])
  @@index([categoryId])
  @@map("products")
}

/// Join table for Product.secondaryCategoryIds (order preserved).
model ProductSecondaryCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")
  position   Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_secondary_categories")
}

/// Join table for Product.collectionIds (order preserved).
model ProductCollection {
  productId    String @map("product_id")
  collectionId String @map("collection_id")
  position     Int

  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

model ProductMedia {
  id        String @id
  productId String @map("product_id")
  mediaId   String @map("media_id")

  alt       String
  sortOrder Int     @map("sort_order")
  isPrimary Boolean @map("is_primary")

  /// Original position in the product's media array (sortOrder is the
  /// DISPLAY order; position is the array order — they can differ).
  position  Int
  createdAt DateTime @map("created_at")

  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([productId])
  @@index([mediaId])
  @@map("product_media")
}

// ── Shopping ────────────────────────────────────────────────────────

model Wishlist {
  id String @id

  /// One wishlist per USER — enforced by the database, not just the app.
  userId    String   @unique @map("user_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id
  wishlistId String   @map("wishlist_id")
  productId  String   @map("product_id")
  position   Int
  createdAt  DateTime @map("created_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// A product appears at most once per wishlist.
  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

model Cart {
  id String @id

  /// One active cart per USER — enforced by the database.
  userId    String   @unique @map("user_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id
  cartId    String @map("cart_id")
  productId String @map("product_id")

  quantity Int

  /// Price SNAPSHOT captured when the line was created — integer paise.
  /// The product's live price may differ; the cart surfaces the change.
  unitPriceAmount   BigInt @map("unit_price_amount")
  unitPriceCurrency String @map("unit_price_currency")

  /// "" today; Phase 7 derives it from stitching/customisation choices so
  /// the same product can occupy multiple lines.
  configurationKey String @map("configuration_key")

  /// Reserved for Phase 7 — persisted verbatim as JSONB:
  /// { selected: boolean; measurementProfileId?: string }
  stitching              Json?   @map("stitching")
  customizationRequestId String? @map("customization_request_id")
  notes                  String?

  position  Int
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Same product + same configuration = the same line (quantity merges).
  @@unique([cartId, productId, configurationKey])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ── Orders (Phase 6C) ───────────────────────────────────────────────

/// A placed order — an immutable HISTORICAL record of one confirmed
/// checkout. Customer identity and the delivery address are SNAPSHOTS of
/// their values at purchase time; later profile/address edits or
/// deletions never touch an order. Money is integer paise (BIGINT);
/// shipping/tax/discount are explicit zeros until those systems exist,
/// so total = subtotal + shipping + tax − discount holds from day one.
model Order {
  id String @id

  /// Customer-facing number (LCS-XXXX-XXXX): unique, unguessable,
  /// non-sequential — never the database id.
  orderNumber String @unique @map("order_number")

  /// Owning USER id — the ownership anchor, like every customer record.
  userId String      @map("user_id")
  status OrderStatus

  currency       String
  subtotalAmount BigInt @map("subtotal_amount")
  shippingAmount BigInt @map("shipping_amount")
  taxAmount      BigInt @map("tax_amount")
  discountAmount BigInt @map("discount_amount")
  totalAmount    BigInt @map("total_amount")

  // Customer snapshot at purchase time.
  customerName  String  @map("customer_name")
  customerEmail String? @map("customer_email")
  customerPhone String? @map("customer_phone")

  // Delivery-address snapshot at purchase time (fulfilment values only —
  // no address-book id, no home/work label).
  shipFullName   String  @map("ship_full_name")
  shipPhone      String  @map("ship_phone")
  shipLine1      String  @map("ship_line1")
  shipLine2      String? @map("ship_line2")
  shipLocality   String? @map("ship_locality")
  shipCity       String  @map("ship_city")
  shipState      String  @map("ship_state")
  shipPostalCode String  @map("ship_postal_code")
  shipCountry    String  @map("ship_country")

  /// One confirmation can never create two orders: unique per user. The
  /// fingerprint of the client-supplied inputs lets the service tell an
  /// honest replay (same → return this order) from key reuse (reject).
  idempotencyKey     String @map("idempotency_key")
  requestFingerprint String @map("request_fingerprint")

  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  activities OrderActivity[]
  notes      OrderNote[]
  customizationRequests CustomizationRequest[] @relation("CustomizationOrder")

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@map("orders")
}

/// One ordered line. Snapshot fields (name, slug, exact prices) make it
/// historically self-sufficient; `productId` is RETAINED with RESTRICT
/// because products in this architecture are archived, never hard-deleted
/// — and the FK now also guarantees nothing can ever hard-delete a
/// product that has been ordered. Phase-7 reserved configuration fields
/// ride over from the cart line verbatim.
model OrderItem {
  id      String @id
  orderId String @map("order_id")

  productId    String @map("product_id")
  nameSnapshot String @map("name_snapshot")
  slugSnapshot String @map("slug_snapshot")

  quantity           Int
  unitPriceAmount    BigInt @map("unit_price_amount")
  lineSubtotalAmount BigInt @map("line_subtotal_amount")
  currency           String

  configurationKey       String  @map("configuration_key")
  stitching              Json?
  customizationRequestId String? @map("customization_request_id")
  notes                  String?

  /// Original position in the order's line array — preserves order.
  position Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  customizationRequests CustomizationRequest[] @relation("CustomizationOrderItem")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Append-only operational history. Order snapshots remain immutable; this
/// records the workflow around them.
model OrderActivity {
  id          String       @id
  orderId     String       @map("order_id")
  type        String
  actorUserId String?      @map("actor_user_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus? @map("to_status")
  metadata    Json?
  createdAt   DateTime     @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User? @relation("OrderActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_activities")
}

/// Private, append-only studio notes. Never included in customer view models.
model OrderNote {
  id           String   @id
  orderId      String   @map("order_id")
  authorUserId String?  @map("author_user_id")
  authorName   String   @map("author_name")
  body         String
  createdAt    DateTime @map("created_at")

  order  Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author User? @relation("OrderNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model CustomizationActivity {
  id                     String             @id
  customizationRequestId String             @map("customization_request_id")
  type                   String
  actorUserId            String?            @map("actor_user_id")
  fromStatus             CustomizationStatus? @map("from_status")
  toStatus               CustomizationStatus? @map("to_status")
  createdAt              DateTime           @map("created_at")

  request CustomizationRequest @relation(fields: [customizationRequestId], references: [id], onDelete: Restrict)
  actor   User? @relation("CustomizationActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([customizationRequestId, createdAt])
  @@map("customization_activities")
}

model CustomizationNote {
  id                     String   @id
  customizationRequestId String   @map("customization_request_id")
  authorUserId            String?  @map("author_user_id")
  authorName              String   @map("author_name")
  body                    String
  createdAt               DateTime @map("created_at")

  request CustomizationRequest @relation(fields: [customizationRequestId], references: [id], onDelete: Restrict)
  author  User? @relation("CustomizationNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([customizationRequestId, createdAt])
  @@map("customization_notes")
}
